# ===== Frontend (Vite / Vercel) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_API_URL=https://api.example.com
# Mock auth is accepted only by the Vite development runtime.
VITE_ENABLE_MOCK_AUTH=false

# ===== Backend Express (Coolify) =====
NODE_ENV=production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CORS_ORIGIN=https://app.example.com
JSON_BODY_LIMIT=2mb
READINESS_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_MAX_CLIENTS=10000
HSTS_MAX_AGE_SECONDS=31536000

# ===== MedBot / n8n =====
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/medbot-chat
INTERNAL_API_KEY=replace_with_a_long_random_secret
AI_PDF_MAX_CONTENT_BYTES=524288

# ===== Playwright automation VPS =====
HORIZON_BOT_TOKEN=replace_with_a_long_random_secret
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=botsplaywright.example.com,n8n.example.com

# ===== WhatsApp Cloud API webhook =====
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_a_long_random_secret
WHATSAPP_APP_SECRET=replace_with_the_meta_app_secret
WHATSAPP_MESSAGE_MAX_CHARS=4096

# ===== Spreadsheet imports =====
UPLOAD_MAX_FILES=10
UPLOAD_MAX_FILE_SIZE_MB=256
UPLOAD_MAX_TOTAL_MB=512
UPLOAD_MAX_ROWS=500000
UPLOAD_ALLOWED_EXTENSIONS=.csv,.xls,.xlsx
UPLOAD_ALLOWED_MIME_TYPES=text/csv,application/csv,text/plain,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ===== Supabase Edge Functions =====
# Configure the same value in Vault (trigger_secret) and the append-sheet secret.
TRIGGER_SECRET=replace_with_a_long_random_secret
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"replace_me"}
